# --- Keitaro ---------------------------------------------------------------
# Адрес без /admin на конце. Ключ: кнопка «API ключ» в шапке эмулятора.
KEITARO_BASE_URL=https://keitaro-for-tests.etolegko.com
KEITARO_API_KEY=

# Сущности, которые подставляются в каждую новую кампанию (ищутся по имени).
KEITARO_DOMAIN=kt-emulator.test
KEITARO_GROUP=FORTESTS
KEITARO_SOURCE=FORTESTS

# --- Приложение ------------------------------------------------------------
# Префикс обязателен по условиям задания: test_<фамилия>_
CAMPAIGN_PREFIX=test_surname_
# true: редактор показывает и меняет только кампании с этим префиксом
EDIT_ONLY_PREFIXED=true
REDIRECT_URL=https://google.com

# Часовой пояс статистики. Должен совпадать с часовым поясом Keitaro,
# иначе «Сегодня» в редакторе не сойдётся с цифрами в админке.
STATS_TIMEZONE=UTC

# --- База данных -----------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./adrobot.db
# Postgres: postgresql+asyncpg://user:pass@localhost:5432/adrobot (pip install asyncpg)
